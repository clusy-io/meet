# Run without external services. Use only for local development and demos.
MEET_MOCK_MODE=1

# Public deployment origin (no path or trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Scheduling policy.
MEET_HOST_TIMEZONE=America/Los_Angeles
MEET_WINDOW_START=09:00
MEET_WINDOW_END=17:00
MEET_DURATION_MINUTES=30
MEET_SLOT_STEP_MINUTES=30
MEET_MIN_NOTICE_MINUTES=240
MEET_HORIZON_DAYS=21
MEET_QUORUM=1
MEET_MEMBERS=[{"key":"founder","name":"Founder","email":"founder@example.com"}]

# Calendar and email copy.
MEET_EVENT_TITLE=Clusy <> {name}
MEET_EVENT_DESCRIPTION=Intro call booked with Clusy Meet.
MEET_BRAND_NAME=Clusy
MEET_EMAIL_FROM=Clusy <meet@example.com>

# Generate each value independently. Do not reuse secrets.
# openssl rand -hex 24
MEET_ADMIN_SECRET=
# openssl rand -hex 32
MEET_TOKEN_SECRET=
# openssl rand -hex 24
CRON_SECRET=

# Google OAuth application.
MEET_GOOGLE_CLIENT_ID=
MEET_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID application.
MEET_MICROSOFT_CLIENT_ID=
MEET_MICROSOFT_CLIENT_SECRET=

# Transactional email.
RESEND_API_KEY=

# Server-only Supabase credentials. Never expose the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
